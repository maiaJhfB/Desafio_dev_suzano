          "201": {
            "headers": {
              "Location": {
                "description": "Caminho do pedido criado.",
                "schema": {
                  "type": "string"
                }
              },
              "Idempotency-Replayed": {
                "description": "true quando a resposta original foi recuperada.",
                "schema": {
