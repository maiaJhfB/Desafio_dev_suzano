  "components": {
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ErrorDetailDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "reason"
        ]
      },
      "ErrorBodyDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetailDto"
            }
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "request_id"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBodyDto"
          }
        },
        "required": [
          "error"
        ]
      },
      "ProdutoResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "categoria": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "descricao": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "preco_centavos": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "quantidade_estoque": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "imagem_url": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "nome",
          "categoria",
          "descricao",
          "preco_centavos",
          "quantidade_estoque",
          "imagem_url",
          "created_at",
          "updated_at"
        ]
      },
      "PaginationResponseDto": {
        "type": "object",
        "properties": {
          "pagina": {
            "type": "integer",
            "minimum": 1
          },
          "limite": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "total_paginas": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "pagina",
          "limite",
          "total",
          "total_paginas"
        ]
      },
      "ProdutosPageResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProdutoResponseDto"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationResponseDto"
          }
        },
        "required": [
          "data",
          "meta"
        ]
      },
      "CreateProdutoDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          },
          "categoria": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          },
          "descricao": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "\\S"
          },
          "preco_centavos": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "quantidade_estoque": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "imagem_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://",
            "nullable": true,
