{
  "name": "@catalogo/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:integrated": "playwright test --config playwright.integrated.config.ts",
    "test:visual": "playwright test --project=chromium --grep @visual",
    "mock:init": "msw init public --save"
  },
  "dependencies": {
    "@catalogo/contracts": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.15",
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.90.0",
    "lucide-react": "^0.468.0",
    "msw": "^2.12.0",
    "next": "16.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.62.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jest": "^30.1.0",
    "jest-environment-jsdom": "^30.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "undici": "^7.16.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
